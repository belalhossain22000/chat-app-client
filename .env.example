# REST API Endpoint (includes /api)
NEXT_PUBLIC_API_URL=https://frontend-task-chatapp.onrender.com/api

# WebSocket Server Endpoint (does NOT include /api)
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com

# Public site URL — used for SEO metadata (OpenGraph / canonical).
# Optional on Vercel: without it the deployment's own URL is used
# (VERCEL_PROJECT_PRODUCTION_URL). Set it for a custom domain or another host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API key — SERVER ONLY (no NEXT_PUBLIC_ prefix). Powers the
# landing-page assistant via /api/assistant. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Largest upload the host will accept, in MB. Vercel's Hobby plan caps a
# serverless request body at 4.5 MB — the app's own per-type limits are clamped
# to this, so raise it only on a plan (or host) with a higher cap.
NEXT_PUBLIC_MAX_UPLOAD_MB=4.5
